# Copy this file to `.env.local` and fill in the keys you have. Every one is
# optional: without a key, that feature falls back or switches off.
#
# For the live site, add the same names under Vercel → Project → Settings →
# Environment Variables (Production), then redeploy.
#
# ---------------------------------------------------------------------------
# SERVER-ONLY KEYS — no VITE_ prefix, so they never reach the browser.
# The site calls its own /api/* routes and the server adds these
# (server/proxy.js). They stay out of the JavaScript bundle.
# ---------------------------------------------------------------------------

# TMDB — the catalogue: trending, in cinemas, top rated, posters, trailers.
# themoviedb.org → Settings → API. Either the short API key or the long
# "API Read Access Token" works.
TMDB_TOKEN=

# OMDb — IMDb, Rotten Tomatoes and Metacritic scores. omdbapi.com/apikey.aspx
OMDB_KEY=

# Watchmode — a direct link to the film on each streaming service.
# api.watchmode.com (free plan: 1,000 requests a month, set countries).
WATCHMODE_KEY=

# Sign-in needs none of the keys below: the server only checks the address is
# real (correct format, no temporary inbox, domain can receive mail) and the
# browser remembers the profile on the device. No passwords, no codes.
# (Supabase variables from the old code-based sign-in are intentionally gone —
# delete SUPABASE_SERVICE_ROLE_KEY, SUPABASE_URL, VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY from Vercel and .env.local if set.)

# Development only, on networks that block api.themoviedb.org by DNS (some
# ISPs do): look TMDB up over DNS-over-HTTPS instead. Leave unset on Vercel.
# TMDB_DNS=doh

# ---------------------------------------------------------------------------
# PUBLIC VALUES — VITE_ prefix, so Vite puts them in the browser bundle.
# That is fine for these two: Supabase's anon (publishable) key only allows
# what the project's settings allow.
# ---------------------------------------------------------------------------

# Supabase (no longer used — left here so old setups know what to delete).
# With these set, nothing changes: sign-in stays name + real email.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Video streaming source (optional override for MovieDetail player; defaults to VidLink / VidSrc / AutoEmbed)
# VITE_VIDEO_SOURCE=https://vidlink.pro/movie/

# Aether / Wyzie (optional)
# VITE_AETHER_BASE_URL=https://backend.aether.cx
# VITE_AETHER_KEY=wyzie-...

