# Copy this file to `.env.local`, then put your real key in the copy.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE YOU PASTE A KEY
#
# Vite INLINES every VITE_-prefixed variable into the JavaScript bundle at
# build time. It is not read at runtime from the server — it becomes a string
# literal in dist/assets/*.js that anyone can read with View Source.
#
# So a key here is PUBLIC. That is a property of a front-end-only app, not a
# configuration mistake, and no amount of .gitignore changes it.
#
#   - only ever use a free, read-only key here
#   - restrict it by HTTP referrer in the provider's dashboard if it offers that
#   - never deploy this build publicly with a paid or write-capable key
#   - rotate the key after your viva
#
# The only real fix is a server that proxies the request and keeps the key.
# This project deliberately has no server.
# ---------------------------------------------------------------------------

# Base URL of the API you are calling.
VITE_AETHER_BASE_URL=

# Your key.
VITE_AETHER_KEY=

# ---------------------------------------------------------------------------
# TMDB — the Netflix catalogue (/movies). Free: themoviedb.org → Settings → API.
# Paste the long "API Read Access Token" (read-only), not the short API key.
VITE_TMDB_TOKEN=
